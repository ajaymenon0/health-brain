# Add these to your existing .env or existing Render service environment.
# npm start runs bot, dashboard and MCP together on PORT (Render default: 10000).
# The standalone MCP process does not need Telegram bot or OpenAI API credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-side-service-role-key
MCP_TELEGRAM_USER_ID=123456789

# Canonical public resource identifier; must end in /mcp.
MCP_PUBLIC_URL=https://your-health-mcp.example.com/mcp
# Exact issuer and public signing-key URL from your OAuth provider's discovery document.
MCP_OAUTH_ISSUER=https://your-authorization-server.example.com/
MCP_OAUTH_JWKS_URL=https://your-authorization-server.example.com/.well-known/jwks.json
# Your own immutable OAuth account subject (JWT sub), not an email or Telegram ID.
MCP_OWNER_SUBJECT=replace-with-your-oauth-subject

# Only used by standalone npm run mcp:start; ignored by npm start.
MCP_HOST=127.0.0.1
MCP_PORT=3001
